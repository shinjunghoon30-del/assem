7. Implement the following pseudocode in assembly language. Use short-circuit evaluation and assume that val1 and X are 32-bit variables.
   다음 의사코드를 어셈블리 언어로 구현하시오. 단락 평가(short-circuit evaluation)를 사용하고, val1과 X는 32비트 변수라고 가정하시오.
if( val1 > ecx ) AND ( ecx > edx )
 X = 1
else
 X = 2;

정답: mov eax, val1
    cmp eax, ecx
    jng L_ELSE        ; !(val1 > ecx) 이면 else로 점프
    cmp ecx, edx
    jng L_ELSE        ; !(ecx > edx) 이면 else로 점프

    mov X, 1
    jmp L_END

  L_ELSE:
      mov X, 2

  L_END:

