9. Implement the following pseudocode in assembly language. Use short-circuit evaluation and assume that X is a 32-bit variable.
   다음 의사코드를 어셈블리 언어로 구현하시오. 단락 평가를 사용하고, X는 32비트 변수라고 가정하시오.
if( ebx > ecx AND ebx > edx) OR ( edx > eax )
 X = 1
else
 X = 2

정답: ; (ebx > ecx AND ebx > edx) 검사
          cmp ebx, ecx
          jng L_CHECK_RIGHT ; ebx > ecx 가 거짓이면 오른쪽 OR 조건 검사로 이동
          cmp ebx, edx
          jg  L_THEN        ; ebx > edx 도 참이면 전체 참 (X = 1)

    L_CHECK_RIGHT:
    ; (edx > eax) 검사
        cmp edx, eax
        jg  L_THEN        ; edx > eax 가 참이면 전체 참 (X = 1)

        mov X, 2          ; 모두 거짓이면 else
        jmp L_END

    L_THEN:
        mov X, 1

    L_END:

10. Implement the following pseudocode in assembly language. Use short-circuit evaluation and assume that A, B, and N are 32-bit signed integers.
   다음 의사코드를 어셈블리 언어로 구현하시오. 단락 평가를 사용하고, A, B, N은 32비트 부호 있는 정수라고 가정하시오.
while N > 0
 if N != 3 AND (N < A OR N > B)
 N = N – 2
 else
 N = N – 1
end whle

정답: WHILE_START:
    cmp N, 0
    jng WHILE_END     ; N > 0 이 아니면 루프 종료

    cmp N, 3
    je  IF_ELSE       ; N == 3 이면 IF 조건(N != 3)이 거짓이므로 ELSE로 이동

    cmp N, A
    jl  IF_THEN       ; N < A 가 참이면 IF 실행부로 이동

    cmp N, B
    jg  IF_THEN       ; N > B 가 참이면 IF 실행부로 이동
    jmp IF_ELSE       ; 둘 다 아니면 ELSE로 이동

IF_THEN:
    sub N, 2
    jmp WHILE_START

IF_ELSE:
    sub N, 1
    jmp WHILE_START

WHILE_END:
